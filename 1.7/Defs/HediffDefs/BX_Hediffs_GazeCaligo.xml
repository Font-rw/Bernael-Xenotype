<Defs>

  <!-- Gaze Caligo Buff -->
  <HediffDef>
    <defName>BX_GazeCaligoBuff</defName>
    <label>gaze caligo buff</label>
    <description>Those open to psychic energy experience an unprecedented surge of power.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.51, 0.71, 0.86)</defaultLabelColor>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3256~3256</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <!-- Gaze Caligo Debuff -->
  <HediffDef>
    <defName>BX_GazeCaligoDebuff</defName>
    <label>gaze caligo debuff</label>
    <description>Those whose minds remain closed writhe under intolerable pressure.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.51, 0.71, 0.86)</defaultLabelColor>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.8</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3256~3256</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <!-- Psychic Overcharge -->
  <HediffDef>
    <defName>BX_PsychicOverchargeHediff</defName>
    <label>psychic overcharge</label>
    <description>A psycaster receives a long-lasting buff that boosts their psychic capabilities even after the Gaze passes.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.51, 0.71, 0.86)</defaultLabelColor>
    <stages>
      <li>
        <statFactors>
          <MeditationFocusGain>2.0</MeditationFocusGain>
          <PsychicEntropyMax>1.5</PsychicEntropyMax>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

</Defs>
