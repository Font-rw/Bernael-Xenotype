<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>BX_FoldShift_Hediff</defName>
    <label>fold shift</label>
    <description>While shifted, the user moves very slowly, cannot attack or use standard psycasts, ignores terrain movement penalties, and becomes completely immune to physical damage.

Unlocks Traverse the Fold for the duration of the shift.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
		<defaultLabelColor>(0.8, 0, 0.7)</defaultLabelColor>
    <comps>
      <li Class="Bernael_Xenotype.HediffCompProperties_NoPathCost"/>

      <li Class="Bernael_Xenotype.HediffCompProperties_GiveHediffOnLoss">
        <hediffDef>XenogermLossShock</hediffDef>
        <hediffSeverity>1</hediffSeverity>
      </li>

      <li Class="Bernael_Xenotype.HediffCompProperties_FoldShiftVisual">
        <visualColor>(0.5, 0.8, 1.0, 0.75)</visualColor>
      </li>

      <li Class="Bernael_Xenotype.HediffCompProperties_ImmuneWithoutWeakDamage">
        <weakDamageDef>EMP</weakDamageDef>
      </li>

      <li Class="Bernael_Xenotype.HediffCompProperties_DisappearsAndStunOnWeakDamage">
        <weakDamageDef>EMP</weakDamageDef>
        <stunTicks>1500</stunTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <disabledWorkTags>Violent</disabledWorkTags>
        <statFactors>
          <MoveSpeed>0.2</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>BX_TraverseTheFold_Hediff</defName>
    <label>traverse the fold</label> <!-- hidden -->
    <description>Traverse the fold.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
		<defaultLabelColor>(0.8, 0, 0.7)</defaultLabelColor>
    <comps>
      <li Class="Bernael_Xenotype.HediffCompProperties_NoPathCost"/>

      <li Class="Bernael_Xenotype.HediffCompProperties_FoldShiftVisual">
        <visualColor>(0.5, 0.8, 1.0, 0.75)</visualColor>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath"/>
    </comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
        <disabledWorkTags>Violent</disabledWorkTags>
      </li>
    </stages>
  </HediffDef>

</Defs>
